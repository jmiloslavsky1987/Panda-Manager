# Phase 86: AWS production env var manifest. Copy to a secret store (AWS Secrets Manager / SSM Parameter Store)
# or to a .env loaded by ECS task definition. Values shown are placeholders — replace before deploying.

# ── Database (RDS PostgreSQL 16) ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:PASSWORD@your-rds-endpoint.rds.amazonaws.com:5432/bigpanda_app

# ── Redis (ElastiCache Redis 7) ───────────────────────────────────────────────
REDIS_URL=redis://your-elasticache-endpoint.cache.amazonaws.com:6379

# ── Application identity ──────────────────────────────────────────────────────
BETTER_AUTH_URL=https://your-production-domain.com
NEXT_PUBLIC_BASE_URL=https://your-production-domain.com
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# ── Google OAuth (production redirect URIs MUST be registered in Google Cloud Console) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-production-domain.com/api/oauth/gmail/callback
GOOGLE_CALENDAR_REDIRECT_URI=https://your-production-domain.com/api/oauth/calendar/callback

# ── Slack OAuth ───────────────────────────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://your-production-domain.com/api/oauth/slack/callback

# ── Okta SSO (DORMANT until populated — leave blank to keep email/password as only auth path) ──
# To activate: populate ALL FOUR values and re-deploy. Code is already in place.
# OKTA_DOMAIN should be the OIDC issuer URL, e.g. https://dev-xxxxx.okta.com/oauth2/default
OKTA_DOMAIN=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_REDIRECT_URI=https://your-production-domain.com/api/auth/callback/okta

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Optional overrides ────────────────────────────────────────────────────────
# BACKUP_DIR overrides default /root/.bigpanda-app/backups (rarely needed on AWS — RDS automated backups are canonical)
# BACKUP_DIR=/mnt/efs/backups
